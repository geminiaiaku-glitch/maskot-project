<UserControl x:Class="Maskot.Windows.Views.MascotView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Viewbox Stretch="Uniform">
  <Grid Width="112" Height="142" RenderTransformOrigin="0.5,0.85" x:Name="Body">
   <Grid.RenderTransform><TransformGroup>
    <ScaleTransform x:Name="Flip" /><RotateTransform x:Name="Tilt" /><TranslateTransform x:Name="Bob" />
   </TransformGroup></Grid.RenderTransform>
   <Image Source="{StaticResource MomoArt}" />
   <Border x:Name="SleepEyes" Background="#F7EAD0" Width="58" Height="15" VerticalAlignment="Top" Margin="0,51,0,0" Visibility="Collapsed">
    <TextBlock Text="⌣     ⌣" Foreground="#493B30" FontSize="16" HorizontalAlignment="Center" Margin="0,-6,0,0" />
   </Border>
   <TextBlock x:Name="SleepMark" Text="z Z" Foreground="#CFE993" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" />
   <TextBlock x:Name="Greeting" Text="✦" Foreground="#F4D17C" FontSize="22" HorizontalAlignment="Left" Margin="0,20,0,0" VerticalAlignment="Top" Visibility="Collapsed" />
  </Grid>
 </Viewbox>
</UserControl>
