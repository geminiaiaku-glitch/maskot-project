<UserControl x:Class="Maskot.Windows.Views.MascotView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Viewbox Stretch="Uniform">
  <Canvas Width="112" Height="152" ClipToBounds="False">
   <Canvas x:Name="Body" Width="112" Height="142" Canvas.Top="6">
    <Canvas.RenderTransform><TransformGroup>
     <ScaleTransform x:Name="Flip" CenterX="56" CenterY="105" />
     <ScaleTransform x:Name="Breath" CenterX="56" CenterY="115" />
     <RotateTransform x:Name="Lean" CenterX="56" CenterY="110" />
     <TranslateTransform x:Name="Bob" />
    </TransformGroup></Canvas.RenderTransform>
    <Path Data="{StaticResource MomoTail}" Fill="#9B7957" Stroke="#493B30" StrokeThickness="2">
     <Path.RenderTransform><RotateTransform x:Name="Tail" CenterX="86" CenterY="108" /></Path.RenderTransform>
    </Path>
    <Path Data="{StaticResource MomoLeftFoot}" Fill="#574335" Stroke="#493B30" StrokeThickness="2">
     <Path.RenderTransform><RotateTransform x:Name="LeftFoot" CenterX="36" CenterY="119" /></Path.RenderTransform>
    </Path>
    <Path Data="{StaticResource MomoRightFoot}" Fill="#574335" Stroke="#493B30" StrokeThickness="2">
     <Path.RenderTransform><RotateTransform x:Name="RightFoot" CenterX="76" CenterY="119" /></Path.RenderTransform>
    </Path>
    <Path Data="{StaticResource MomoLeftArm}" Fill="#C1D691" Stroke="#493B30" StrokeThickness="2">
     <Path.RenderTransform><RotateTransform x:Name="LeftArm" CenterX="28" CenterY="96" /></Path.RenderTransform>
    </Path>
    <Path Data="{StaticResource MomoRightArm}" Fill="#C1D691" Stroke="#493B30" StrokeThickness="2">
     <Path.RenderTransform><RotateTransform x:Name="RightArm" CenterX="84" CenterY="96" /></Path.RenderTransform>
    </Path>
    <Path Data="{StaticResource MomoShirt}" Fill="#DBEAAE" Stroke="#493B30" StrokeThickness="2.4" />
    <Path Data="M33,94 Q56,107 80,94 L76,105 Q56,118 36,105 Z" Fill="#A0B574" />
    <Path Data="M41,112 Q56,119 71,112 L68,121 Q56,125 44,121 Z" Stroke="#B0C584" StrokeThickness="1.5" />
    <Path Data="M49,98 L62,98 L63,113 Q56,119 49,113 Z" Fill="#EAC46B" Stroke="#756238" StrokeThickness="1.2" />
    <Path Data="M51,102 L61,102 L61,105 L51,105 Z M51,108 L61,108 L61,111 L51,111 Z" Fill="#70552F" />
    <Path Data="M56,98 C41,84 42,102 56,103 C69,87 73,100 56,103" Fill="#FAF4DE" />
    <Canvas Width="112" Height="100">
     <Canvas.RenderTransform><RotateTransform x:Name="Head" CenterX="56" CenterY="87" /></Canvas.RenderTransform>
     <Path Data="{StaticResource MomoHead}" Fill="#F7EAD0" Stroke="#493B30" StrokeThickness="2.5" StrokeLineJoin="Round" />
     <Path Data="M23,16 L25,34 L37,27 Z M89,17 L87,34 L77,27 Z" Fill="#E9AE9C" />
     <Path Data="M23,44 Q28,27 43,30 Q51,34 47,43 Q36,46 23,44" Fill="#E7D5B3" />
     <Path Data="M26,49 L33,47 M83,47 L90,49" Stroke="#BBA78A" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
     <Canvas Width="112" Height="100">
      <Canvas.RenderTransform><ScaleTransform x:Name="Eyes" CenterX="56" CenterY="60" /></Canvas.RenderTransform>
      <Ellipse Canvas.Left="34" Canvas.Top="55" Width="7" Height="10" Fill="#493B30" />
      <Ellipse Canvas.Left="72" Canvas.Top="55" Width="7" Height="10" Fill="#493B30" />
      <Ellipse Canvas.Left="35.4" Canvas.Top="56" Width="2.1" Height="2.7" Fill="#FFF9E9" />
      <Ellipse Canvas.Left="73.4" Canvas.Top="56" Width="2.1" Height="2.7" Fill="#FFF9E9" />
     </Canvas>
     <Ellipse Canvas.Left="23" Canvas.Top="67" Width="16" Height="8" Fill="#EFB5A5" />
     <Ellipse Canvas.Left="74" Canvas.Top="67" Width="16" Height="8" Fill="#EFB5A5" />
     <Path Data="M52,66 Q56,63 60,66 L56,70 Z" Fill="#735445" />
     <Path Data="M47,73 Q51,78 56,72 Q61,78 65,73" Stroke="#735445" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
    </Canvas>
    <TextBlock x:Name="SleepMark" Canvas.Left="88" Canvas.Top="4" Text="z Z" Foreground="#BEDBFA" FontSize="15" FontWeight="Bold" Opacity="0" />
    <TextBlock x:Name="Greeting" Canvas.Left="0" Canvas.Top="26" Text="✦" Foreground="#F4D17C" FontSize="21" Visibility="Collapsed" />
   </Canvas>
  </Canvas>
 </Viewbox>
</UserControl>
