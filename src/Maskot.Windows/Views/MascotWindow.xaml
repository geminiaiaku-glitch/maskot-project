<Window x:Class="Maskot.Windows.Views.MascotWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Maskot.Windows.Views"
 Title="Maskot — Momo" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False" Width="112" Height="142"
 MouseLeftButtonDown="PointerDown" MouseLeftButtonUp="PointerUp" MouseMove="PointerMove" MouseRightButtonUp="QuickMenu" LostMouseCapture="CaptureLost"
 AllowDrop="True" DragOver="FilesDragged" Drop="FilesDropped">
 <Grid Background="{x:Null}">
  <local:MascotView x:Name="Character" />
  <Border x:Name="Notch" Visibility="Collapsed" Background="#F515171B" CornerRadius="0,0,18,18" Padding="14,7">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <Ellipse Fill="{StaticResource Accent}" Width="8" Height="8" VerticalAlignment="Center" HorizontalAlignment="Left" />
    <TextBlock x:Name="NotchLabel" Grid.Column="1" Text="Momo menemanimu" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    <TextBlock x:Name="NotchTimer" Grid.Column="2" FontSize="11" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="8,0,0,0" />
   </Grid>
  </Border>
  <Border x:Name="TimerPill" Background="#EF1B2119" CornerRadius="7" HorizontalAlignment="Center" VerticalAlignment="Bottom" Padding="7,2" IsHitTestVisible="False" Visibility="Collapsed">
   <TextBlock x:Name="SmallTimer" FontSize="10" Foreground="{StaticResource Accent}" />
  </Border>
 </Grid>
</Window>
