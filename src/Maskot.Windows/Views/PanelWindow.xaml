<Window x:Class="Maskot.Windows.Views.PanelWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Maskot — Ruang kecilmu" Width="412" Height="610" WindowStyle="None" AllowsTransparency="True"
 Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
 PreviewKeyDown="PanelKeyDown" Deactivated="PanelDeactivated" AllowDrop="True" Drop="FilesDropped" DragOver="FilesDragged">
 <Border Background="#FA191C20" BorderBrush="#444B49" BorderThickness="1" CornerRadius="22" Padding="20,18,20,14">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <Grid Margin="0,0,0,16">
    <StackPanel>
     <StackPanel Orientation="Horizontal"><Ellipse Fill="{StaticResource Accent}" Width="7" Height="7" Margin="0,0,8,0" /><TextBlock Text="M A S K O T" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}" /></StackPanel>
     <TextBlock Text="Ruang kecil, hari lebih ringan." FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />
    </StackPanel>
    <Button Content="×" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="9,3" Margin="0" ToolTip="Tutup panel (Escape)" Click="CloseClicked" />
   </Grid>
   <TabControl x:Name="Tabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">
    <TabItem Header="Musik">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,6,0,0">
       <DockPanel Margin="0,0,0,12"><TextBlock Text="SUMBER MEDIA" Style="{StaticResource Caption}" VerticalAlignment="Center" /><Button Content="↻" DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="8,3" Margin="10,0,0,0" ToolTip="Muat ulang sesi media" Click="RefreshMediaClicked" /></DockPanel>
       <ComboBox x:Name="Sources" SelectionChanged="SourceChanged" Margin="0,0,0,18" MinHeight="28" ToolTip="Pilih aplikasi pemutar" />
       <Border Background="#252B27" CornerRadius="15" Padding="16">
        <StackPanel>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Background="#353D32" CornerRadius="12" Width="72" Height="72"><Grid><TextBlock Text="♫" FontSize="35" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" /><Image x:Name="Cover" Stretch="UniformToFill" /></Grid></Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock x:Name="TrackTitle" Text="Belum ada musik" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock x:Name="TrackArtist" Text="Beri harimu sedikit irama." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel>
         </Grid>
         <Slider x:Name="Seek" Minimum="0" Maximum="1" Value="0" IsEnabled="False" Margin="0,18,0,4" PreviewMouseLeftButtonDown="SeekStarted" PreviewMouseLeftButtonUp="SeekFinished" PreviewKeyUp="SeekKeyUp" IsMoveToPointEnabled="True" ToolTip="Posisi lagu" />
         <DockPanel><TextBlock x:Name="Elapsed" Text="0:00" Style="{StaticResource Caption}" /><TextBlock x:Name="Duration" Text="0:00" Style="{StaticResource Caption}" HorizontalAlignment="Right" /></DockPanel>
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,13,0,0">
          <Button x:Name="Previous" Content="⏮" FontSize="19" Click="PreviousClicked" ToolTip="Lagu sebelumnya" IsEnabled="False" />
          <Button x:Name="PlayPause" Content="▶" FontSize="20" Width="66" Style="{StaticResource Primary}" Click="PlayClicked" ToolTip="Putar / jeda" IsEnabled="False" />
          <Button x:Name="Next" Content="⏭" FontSize="19" Margin="0" Click="NextClicked" ToolTip="Lagu berikutnya" IsEnabled="False" />
         </StackPanel>
        </StackPanel>
       </Border>
       <TextBlock x:Name="MediaStatus" Style="{StaticResource Caption}" Margin="0,10,0,0" />
       <TextBlock Text="LIRIK" Style="{StaticResource Caption}" Margin="0,20,0,10" />
       <TextBlock x:Name="LyricText" Text="Aktifkan lirik online di Setelan untuk menemani musikmu." FontSize="16" TextWrapping="Wrap" Foreground="#DFEBCB" LineHeight="25" MaxHeight="125" />
       <TextBlock x:Name="LyricStatus" Style="{StaticResource Caption}" Margin="0,9,0,0" />
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="Fokus">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,8,0,0">
       <TextBlock Text="Satu hal, satu waktu." Style="{StaticResource Section}" />
       <Border Background="#252B27" CornerRadius="18" Padding="18,22">
        <StackPanel HorizontalAlignment="Center">
         <TextBlock x:Name="PhaseLabel" Text="WAKTU FOKUS" Foreground="{StaticResource Accent}" FontSize="11" HorizontalAlignment="Center" />
         <TextBlock x:Name="Countdown" Text="25:00" FontSize="64" FontWeight="Light" FontFamily="Segoe UI Variable Display, Segoe UI" HorizontalAlignment="Center" Margin="0,8" />
         <TextBlock x:Name="TimerStatus" Text="Tarik napas. Mulai saat kamu siap." Style="{StaticResource Caption}" HorizontalAlignment="Center" />
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
          <Button x:Name="StartPause" Content="Mulai fokus" MinWidth="115" Style="{StaticResource Primary}" Click="TimerToggle" /><Button Content="Reset" Click="TimerReset" Margin="0" />
         </StackPanel>
        </StackPanel>
       </Border>
       <Grid Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,8,0"><TextBlock Text="Fokus · menit" Style="{StaticResource Caption}" Margin="0,0,0,8" /><TextBox x:Name="FocusMinutes" Text="25" LostFocus="TimerSettingsChanged" MaxLength="3" /></StackPanel>
        <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Istirahat · menit" Style="{StaticResource Caption}" Margin="0,0,0,8" /><TextBox x:Name="BreakMinutes" Text="5" LostFocus="TimerSettingsChanged" MaxLength="3" /></StackPanel>
       </Grid>
       <TextBlock Text="Timer mengikuti waktu nyata, termasuk saat komputer tidur. Setelah sesi selesai, sesi berikutnya menunggu kamu menekan Mulai." Style="{StaticResource Caption}" Margin="0,15,0,0" />
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="Ruang">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
       <TextBlock Text="Yang ingin kamu ingat." Style="{StaticResource Section}" />
       <TextBox x:Name="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="98" VerticalScrollBarVisibility="Auto" TextChanged="ContentEdited" ToolTip="Catatan disimpan otomatis di perangkat ini" />
       <TextBlock Text="TUGAS KECIL" Style="{StaticResource Caption}" Margin="0,20,0,10" />
       <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="+" Width="36" Style="{StaticResource Primary}" Click="AddTask" Margin="8,0,0,0" /><TextBox x:Name="NewTask" KeyDown="TaskKeyDown" ToolTip="Tulis tugas, lalu tekan Enter" MaxLength="500" /></DockPanel>
       <ItemsControl x:Name="TaskList"><ItemsControl.ItemTemplate><DataTemplate>
        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions>
         <CheckBox IsChecked="{Binding Done, Mode=TwoWay}" Click="TaskEdited" />
         <TextBox Grid.Column="1" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Padding="6" MaxLength="500" LostFocus="TaskEdited" />
         <Button Grid.Column="2" Content="×" Padding="6,2" Margin="4,0,0,0" Tag="{Binding}" Click="DeleteTask" ToolTip="Hapus tugas" />
        </Grid>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <TextBlock Text="FILE SHELF" Style="{StaticResource Caption}" Margin="0,20,0,10" />
       <Border BorderBrush="#4C5840" BorderThickness="1" Background="#232A21" CornerRadius="12" Padding="14"><StackPanel><TextBlock Text="＋  Letakkan file di sini" Foreground="{StaticResource Accent}" /><TextBlock Text="Hanya menyimpan pintasan. File aslinya tetap di tempat." Style="{StaticResource Caption}" Margin="0,5,0,0" /></StackPanel></Border>
       <ItemsControl x:Name="ShelfList" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate>
        <StackPanel Margin="0,4" Background="#25282C">
         <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="9,8,9,3" Tag="{Binding}" PreviewMouseLeftButtonDown="ShelfDragStart" PreviewMouseMove="ShelfDragMove" ToolTip="Tarik nama file ke aplikasi lain" />
         <TextBlock Text="File tidak ditemukan" Foreground="#F0BDA2" FontSize="11" Margin="9,0,0,4"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Exists}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
         <StackPanel Orientation="Horizontal" Margin="8,2,8,8"><Button Content="Buka" Padding="9,4" Tag="{Binding}" Click="OpenShelf" /><Button Content="Lokasi" Padding="9,4" Tag="{Binding}" Click="LocateShelf" /><Button Content="Hapus pintasan" Padding="9,4" Tag="{Binding}" Click="DeleteShelf" /></StackPanel>
        </StackPanel>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="Setelan">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
       <TextBlock Text="Kenalan dengan Momo." Style="{StaticResource Section}" />
       <TextBlock Text="Teman kecil yang menemanimu tanpa terburu-buru." Style="{StaticResource Caption}" Margin="0,0,0,15" />
       <StackPanel Orientation="Horizontal"><Button Content="Jalan-jalan" Style="{StaticResource Primary}" Click="WalkClicked" /><Button Content="Diam di sini" Click="StayClicked" /></StackPanel>
       <TextBlock Text="Ukuran karakter" Margin="0,20,0,7" /><Slider x:Name="SizeSlider" Minimum="0.65" Maximum="1.8" Value="1" ValueChanged="PreferenceChanged" ToolTip="Ukuran karakter" />
       <TextBlock Text="Kecepatan berjalan" Margin="0,15,0,7" /><Slider x:Name="SpeedSlider" Minimum="10" Maximum="100" Value="32" ValueChanged="PreferenceChanged" ToolTip="Kecepatan berjalan" />
       <CheckBox x:Name="Animations" Content="Animasi tambahan" Click="PreferenceChanged" Margin="0,15,0,5" />
       <CheckBox x:Name="Fullscreen" Content="Sembunyikan saat aplikasi fullscreen" Click="PreferenceChanged" />
       <CheckBox x:Name="Autostart" Content="Jalankan saat login Windows" Click="AutostartChanged" />
       <CheckBox x:Name="OnlineLyrics" Content="Lirik online melalui LRCLIB" Click="LyricsChanged" Margin="0,16,0,5" />
       <TextBlock Text="Jika diaktifkan, judul lagu, artis, dan durasi dikirim ke lrclib.net lewat HTTPS. Tanpa akun atau API key. Tidak ada telemetry." Style="{StaticResource Caption}" />
       <Border Background="#25282C" CornerRadius="12" Padding="13" Margin="0,20,0,15"><TextBlock Text="Seret Momo ke tengah atas monitor, lalu lepaskan untuk menjadi notch. Tarik notch ke bawah untuk mengembalikannya. Escape membatalkan drag." Style="{StaticResource Caption}" /></Border>
       <Button Content="Keluar sepenuhnya" HorizontalAlignment="Left" Click="QuitClicked" />
       <TextBlock Text="Maskot 0.1 · Momo adalah aset vektor orisinal sementara." Style="{StaticResource Caption}" Margin="0,14,0,0" />
      </StackPanel>
     </ScrollViewer>
    </TabItem>
   </TabControl>
   <StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock x:Name="Status" TextWrapping="Wrap" FontSize="11" Foreground="#EAC99F" MaxHeight="44" /><DockPanel Margin="0,5,0,0"><TextBlock Text="✦  Pelan-pelan juga sampai." Style="{StaticResource Caption}" /><TextBlock Text="LOKAL · TANPA AKUN" FontSize="9" Foreground="#798477" HorizontalAlignment="Right" VerticalAlignment="Center" /></DockPanel></StackPanel>
  </Grid>
 </Border>
</Window>
