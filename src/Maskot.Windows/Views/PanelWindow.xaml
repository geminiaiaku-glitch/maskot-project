<Window x:Class="Maskot.Windows.Views.PanelWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Maskot.Windows.Views"
 Title="Maskot — Momo" Width="420" Height="282" WindowStyle="None" AllowsTransparency="True"
 Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
 PreviewKeyDown="PanelKeyDown" Deactivated="PanelDeactivated" AllowDrop="True" Drop="FilesDropped" DragOver="FilesDragged">
 <Window.Resources>
  <Style x:Key="PanelIcon" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#909097" />
   <Setter Property="FontFamily" Value="Segoe MDL2 Assets" /><Setter Property="FontSize" Value="15" />
   <Setter Property="Width" Value="34" /><Setter Property="Height" Value="28" />
   <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="1,0" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="IconBody" Background="{TemplateBinding Background}" CornerRadius="12" BorderThickness="1" BorderBrush="Transparent">
     <TextBlock Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="IconBody" Property="Background" Value="#303038" /><Setter Property="Foreground" Value="#FFFFFF" /></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="IconBody" Property="Opacity" Value=".6" /></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="IconBody" Property="BorderBrush" Value="#A9CFFF" /></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="IconBody" Property="Opacity" Value=".3" /></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CarouselArrow" TargetType="Button" BasedOn="{StaticResource PanelIcon}">
   <Setter Property="Width" Value="22" /><Setter Property="Height" Value="26" />
   <Setter Property="FontSize" Value="10" /><Setter Property="Background" Value="#17171B" />
  </Style>
 </Window.Resources>
 <Viewbox Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
 <Border x:Name="PanelShell" Width="420" Height="282" Background="#FE050506" BorderBrush="#25252B" BorderThickness="1" CornerRadius="26" Padding="12,12,12,10">
  <Grid x:Name="ShellContent">
   <Grid.RenderTransform><TranslateTransform x:Name="OpenOffset" /></Grid.RenderTransform>
   <Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <Grid x:Name="HeaderGrip" Margin="8,0,8,4" Background="Transparent" ToolTip="Tarik ke bawah untuk melepaskan notch · Escape membatalkan"
    MouseLeftButtonDown="HeaderPressed" MouseMove="HeaderMoved" MouseLeftButtonUp="HeaderReleased" LostMouseCapture="HeaderCaptureLost">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <TextBlock x:Name="PageTitle" Text="Musik" FontSize="11" FontWeight="SemiBold" Foreground="#F083A0" VerticalAlignment="Center" />
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Border BorderBrush="#40DF87" BorderThickness="1.5" Width="14" Height="14" CornerRadius="7" Margin="0,0,7,0" ToolTip="Momo aktif"><Ellipse Width="4" Height="4" Fill="#40DF87" /></Border>
     <TextBlock x:Name="PanelDate" Text="Sel, 27 Okt" FontSize="10" Foreground="#A9A9B0" VerticalAlignment="Center" />
     <TextBlock x:Name="PanelClock" Text="00:00" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <local:ActivityBars x:Name="PanelBars" Width="19" Height="17" Margin="0,0,3,0" />
     <Button Content="&#xE711;" Style="{StaticResource PanelIcon}" Width="20" Height="20" FontSize="9" ToolTip="Tutup (Escape)" AutomationProperties.Name="Tutup panel" Click="CloseClicked" />
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
    <Button Content="&#xE76B;" Style="{StaticResource CarouselArrow}" VerticalAlignment="Center" Click="PreviousPageClicked" ToolTip="Halaman sebelumnya · Ctrl+←" AutomationProperties.Name="Halaman sebelumnya" />
    <Grid x:Name="PageSurface" Grid.Column="1" Margin="8,0" ClipToBounds="True">
     <Grid.RenderTransform><TranslateTransform x:Name="PageOffset" /></Grid.RenderTransform>
     <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0" Padding="0" SelectionChanged="TabChanged" KeyboardNavigation.TabNavigation="Continue">
      <TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" /></ControlTemplate></TabControl.Template>
    <TabItem Header="Musik">
     <Grid x:Name="MusicLayout" Margin="0,3,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="LyricsColumn" Width="0" /></Grid.ColumnDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
       <StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
         <Border Background="#1A202C" CornerRadius="12" Width="62" Height="62" HorizontalAlignment="Left"><Grid>
          <TextBlock Text="♫" FontSize="28" Foreground="#A3B2CB" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Image x:Name="Cover" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,62,62" RadiusX="12" RadiusY="12" /></Image.Clip></Image>
         </Grid></Border>
         <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,0,0,0">
          <TextBlock x:Name="TrackTitle" Text="Belum ada musik" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxHeight="42" TextWrapping="Wrap" />
          <TextBlock x:Name="TrackArtist" Text="Putar lagu favoritmu." Foreground="#929299" TextTrimming="CharacterEllipsis" FontSize="11" Margin="0,4,0,0" />
         </StackPanel>
        </Grid>
        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="35" /><ColumnDefinition Width="*" /><ColumnDefinition Width="35" /></Grid.ColumnDefinitions>
         <TextBlock x:Name="Elapsed" Text="0:00" FontSize="10" Foreground="#A1A1A8" VerticalAlignment="Center" />
         <Slider x:Name="Seek" Grid.Column="1" Minimum="0" Maximum="1" Value="0" IsEnabled="False" PreviewMouseLeftButtonDown="SeekStarted" PreviewMouseLeftButtonUp="SeekFinished" LostMouseCapture="SeekCaptureLost" PreviewKeyUp="SeekKeyUp" IsMoveToPointEnabled="True" ToolTip="Posisi lagu" AutomationProperties.Name="Posisi lagu" />
         <TextBlock x:Name="Duration" Grid.Column="2" Text="0:00" FontSize="10" Foreground="#A1A1A8" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <Grid Margin="0,7,0,0">
         <Button x:Name="LyricsToggle" Content="&#xE8F2;" Style="{StaticResource PanelIcon}" Click="ToggleLyricsPanel" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="Tampilkan / sembunyikan lirik" AutomationProperties.Name="Tampilkan atau sembunyikan lirik" />
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button x:Name="Previous" Width="30" Height="34" Padding="8" Background="Transparent" Click="PreviousClicked" ToolTip="Lagu sebelumnya" AutomationProperties.Name="Lagu sebelumnya" IsEnabled="False"><Path Data="M0,0 L2,0 L2,14 L0,14 Z M15,0 L4,7 L15,14 Z" Fill="White" Stretch="Uniform" /></Button>
          <Button x:Name="PlayPause" Width="36" Height="36" Padding="12,10" Style="{StaticResource MediaPlay}" Click="PlayClicked" ToolTip="Putar / jeda" AutomationProperties.Name="Putar atau jeda" IsEnabled="False"><Path x:Name="PlayGlyph" Data="M1,0 L12,7 L1,14 Z" Fill="#080809" Stretch="Uniform" /></Button>
          <Button x:Name="Next" Width="30" Height="34" Padding="8" Background="Transparent" Margin="0" Click="NextClicked" ToolTip="Lagu berikutnya" AutomationProperties.Name="Lagu berikutnya" IsEnabled="False"><Path Data="M0,0 L11,7 L0,14 Z M13,0 L15,0 L15,14 L13,14 Z" Fill="White" Stretch="Uniform" /></Button>
         </StackPanel>
         <Button Content="&#xE95D;" Style="{StaticResource PanelIcon}" Click="ToggleSources" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Pilih aplikasi pemutar" AutomationProperties.Name="Pilih sumber musik" />
        </Grid>
        <TextBlock x:Name="MediaStatus" Style="{StaticResource Caption}" Margin="0,7,0,0" FontSize="10" MaxHeight="28" />
        <Grid x:Name="SourcePicker" Visibility="Collapsed" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions>
         <ComboBox x:Name="Sources" SelectionChanged="SourceChanged" MinHeight="28" ToolTip="Pilih aplikasi pemutar" AutomationProperties.Name="Sumber musik" />
         <Button Grid.Column="1" Content="↻" Padding="4,3" Margin="4,0,0,0" ToolTip="Muat ulang sesi media" AutomationProperties.Name="Muat ulang media" Click="RefreshMediaClicked" />
        </Grid>
       </StackPanel>
      </ScrollViewer>
      <Border x:Name="LyricsPane" Grid.Column="1" Visibility="Collapsed" BorderBrush="#354153" BorderThickness="1,0,0,0" Padding="14,0,0,0" Margin="14,0,0,0">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
         <TextBlock Text="LIRIK" FontSize="9" Foreground="#7D93B2" Margin="0,0,0,9" />
         <TextBlock x:Name="PreviousLyric" Foreground="#626D80" FontSize="12" TextWrapping="Wrap" MaxHeight="34" Margin="0,0,0,6" />
         <TextBlock x:Name="LyricText" Text="Aktifkan lirik online untuk menemani musikmu." FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#E1EBFF" LineHeight="23" />
         <TextBlock x:Name="NextLyric" Foreground="#7D8BA3" FontSize="12" TextWrapping="Wrap" MaxHeight="35" Margin="0,7,0,0" />
         <TextBlock x:Name="LyricStatus" Style="{StaticResource Caption}" Margin="0,9,0,0" FontSize="9" />
         <StackPanel x:Name="LyricsConsent" Margin="0,8,0,0"><TextBlock Text="Judul, artis, dan durasi lagu dikirim ke LRCLIB untuk mencari lirik." Style="{StaticResource Caption}" FontSize="10" /><Button Content="Aktifkan lirik online" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="9,6" FontSize="10" Click="EnableLyricsClicked" /></StackPanel>
         <Button x:Name="RetryLyrics" Content="Cari lagi" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="9,4" FontSize="10" Click="RetryLyricsClicked" Visibility="Collapsed" />
        </StackPanel>
       </ScrollViewer>
      </Border>
     </Grid>
    </TabItem>
    <TabItem Header="Fokus">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,10,0,0">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="105" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid Width="92" Height="92" HorizontalAlignment="Left">
         <Ellipse Stroke="#332225" StrokeThickness="7" />
         <Path Data="M46,4 A42,42 0 1 1 4,46" Stroke="#F58C91" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
         <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="#FFE4E5" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
         <TextBlock x:Name="PhaseLabel" Text="WAKTU FOKUS" Foreground="#DFB096" FontSize="10" />
         <TextBlock x:Name="Countdown" Text="25:00" FontSize="45" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI" />
         <TextBlock x:Name="TimerStatus" Text="Mulai saat kamu siap." Style="{StaticResource Caption}" FontSize="10" />
        </StackPanel>
       </Grid>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
        <Button x:Name="StartPause" Content="Mulai fokus" MinWidth="126" Style="{StaticResource Primary}" Click="TimerToggle" /><Button Content="↻  Reset" Click="TimerReset" Margin="0" />
       </StackPanel>
       <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,7,0"><TextBlock Text="Fokus · menit" Style="{StaticResource Caption}" Margin="0,0,0,5" /><TextBox x:Name="FocusMinutes" Text="25" LostFocus="TimerSettingsChanged" MaxLength="3" Padding="9,6" AutomationProperties.Name="Durasi fokus dalam menit" /></StackPanel>
        <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="Istirahat · menit" Style="{StaticResource Caption}" Margin="0,0,0,5" /><TextBox x:Name="BreakMinutes" Text="5" LostFocus="TimerSettingsChanged" MaxLength="3" Padding="9,6" AutomationProperties.Name="Durasi istirahat dalam menit" /></StackPanel>
       </Grid>
       <TextBlock Text="Tetap menghitung saat komputer tidur. Sesi berikutnya menunggu kamu siap." Style="{StaticResource Caption}" FontSize="10" Margin="0,12,0,0" />
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="Ruang">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
       <TextBlock Text="Yang ingin kamu ingat." Style="{StaticResource Section}" />
       <TextBox x:Name="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="98" VerticalScrollBarVisibility="Auto" TextChanged="ContentEdited" ToolTip="Catatan disimpan otomatis di perangkat ini" />
       <TextBlock Text="TUGAS KECIL" Style="{StaticResource Caption}" Margin="0,20,0,10" />
       <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="+" Width="36" Style="{StaticResource Primary}" Click="AddTask" Margin="8,0,0,0" /><TextBox x:Name="NewTask" KeyDown="TaskKeyDown" ToolTip="Tulis tugas, lalu tekan Enter" MaxLength="500" /></DockPanel>
       <ItemsControl x:Name="TaskList"><ItemsControl.ItemTemplate><DataTemplate>
        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions>
         <CheckBox IsChecked="{Binding Done, Mode=TwoWay}" Click="TaskEdited" />
         <TextBox Grid.Column="1" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Padding="6" MaxLength="500" LostFocus="TaskEdited" />
         <Button Grid.Column="2" Content="×" Padding="6,2" Margin="4,0,0,0" Tag="{Binding}" Click="DeleteTask" ToolTip="Hapus tugas" />
        </Grid>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <TextBlock Text="FILE SHELF" Style="{StaticResource Caption}" Margin="0,20,0,10" />
       <Border BorderBrush="#34343A" BorderThickness="1" Background="#111114" CornerRadius="12" Padding="14"><StackPanel><TextBlock Text="＋  Letakkan file di sini" Foreground="{StaticResource Accent}" /><TextBlock Text="Hanya menyimpan pintasan. File aslinya tetap di tempat." Style="{StaticResource Caption}" Margin="0,5,0,0" /></StackPanel></Border>
       <ItemsControl x:Name="ShelfList" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate>
        <StackPanel Margin="0,4" Background="#151518">
         <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="9,8,9,3" Tag="{Binding}" PreviewMouseLeftButtonDown="ShelfDragStart" PreviewMouseMove="ShelfDragMove" ToolTip="Tarik nama file ke aplikasi lain" />
         <TextBlock Text="File tidak ditemukan" Foreground="#F0BDA2" FontSize="11" Margin="9,0,0,4"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Exists}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
         <StackPanel Orientation="Horizontal" Margin="8,2,8,8"><Button Content="Buka" Padding="9,4" Tag="{Binding}" Click="OpenShelf" /><Button Content="Lokasi" Padding="9,4" Tag="{Binding}" Click="LocateShelf" /><Button Content="Hapus pintasan" Padding="9,4" Tag="{Binding}" Click="DeleteShelf" /></StackPanel>
        </StackPanel>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="Setelan">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
       <TextBlock Text="Kenalan dengan Momo." Style="{StaticResource Section}" />
       <TextBlock Text="Teman kecil yang menemanimu tanpa terburu-buru." Style="{StaticResource Caption}" Margin="0,0,0,15" />
       <Grid Margin="0,0,0,12"><TextBlock x:Name="ModeStatus" Text="● Berjalan · selalu di atas" FontSize="10" Foreground="#888891" VerticalAlignment="Center" /><Button x:Name="ModeAction" Content="Diam" HorizontalAlignment="Right" Padding="10,4" FontSize="10" Margin="0" Click="ModeActionClicked" /></Grid>
       <StackPanel Orientation="Horizontal"><Button Content="Jalan-jalan" Style="{StaticResource Primary}" Click="WalkClicked" /><Button Content="Diam di sini" Click="StayClicked" /><Button Content="Jadi notch" Click="DockClicked" Margin="0" /></StackPanel>
       <TextBlock Text="Ukuran karakter" Margin="0,20,0,7" /><Slider x:Name="SizeSlider" Minimum="0.65" Maximum="1.8" Value="1" ValueChanged="PreferenceChanged" ToolTip="Ukuran karakter" />
       <TextBlock Text="Kecepatan berjalan" Margin="0,15,0,7" /><Slider x:Name="SpeedSlider" Minimum="10" Maximum="100" Value="32" ValueChanged="PreferenceChanged" ToolTip="Kecepatan berjalan" />
       <CheckBox x:Name="Animations" Content="Animasi Momo: kaki, ekor, napas, kedip" Click="PreferenceChanged" Margin="0,15,0,5" />
       <CheckBox x:Name="Fullscreen" Content="Sembunyikan saat aplikasi fullscreen" Click="PreferenceChanged" /><TextBlock Text="Biarkan mati agar Momo tetap tampil di atas jendela fullscreen." Style="{StaticResource Caption}" Margin="0,0,0,8" />
       <CheckBox x:Name="Autostart" Content="Jalankan saat login Windows" Click="AutostartChanged" />
       <CheckBox x:Name="OnlineLyrics" Content="Lirik online melalui LRCLIB" Click="LyricsChanged" Margin="0,16,0,5" />
       <TextBlock Text="Jika diaktifkan, judul lagu, artis, dan durasi dikirim ke lrclib.net lewat HTTPS. Tanpa akun atau API key. Tidak ada telemetry." Style="{StaticResource Caption}" />
       <Border Background="#151518" CornerRadius="12" Padding="13" Margin="0,20,0,15"><TextBlock Text="Seret Momo ke tengah atas monitor, lalu lepaskan untuk menjadi notch. Tarik notch ke bawah untuk mengembalikannya. Escape membatalkan drag." Style="{StaticResource Caption}" /></Border>
       <Button Content="Keluar sepenuhnya" HorizontalAlignment="Left" Click="QuitClicked" />
       <TextBlock Text="Maskot 0.4.0 · Momo adalah aset vektor orisinal sementara." Style="{StaticResource Caption}" Margin="0,14,0,0" />
      </StackPanel>
     </ScrollViewer>
    </TabItem>
     </TabControl>
    </Grid>
    <Button Grid.Column="2" Content="&#xE76C;" Style="{StaticResource CarouselArrow}" VerticalAlignment="Center" Click="NextPageClicked" ToolTip="Halaman berikutnya · Ctrl+→" AutomationProperties.Name="Halaman berikutnya" />
   </Grid>
   <StackPanel Grid.Row="2" Margin="0,7,0,0">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
     <Border x:Name="DotMusic" Width="13" Height="3" CornerRadius="1.5" Background="#F083A0" Margin="2,0" />
     <Border x:Name="DotFocus" Width="4" Height="3" CornerRadius="1.5" Background="#45454C" Margin="2,0" />
     <Border x:Name="DotSpace" Width="4" Height="3" CornerRadius="1.5" Background="#45454C" Margin="2,0" />
     <Border x:Name="DotSettings" Width="4" Height="3" CornerRadius="1.5" Background="#45454C" Margin="2,0" />
    </StackPanel>
    <Border Background="#161619" CornerRadius="17" Padding="4,2" HorizontalAlignment="Center">
     <StackPanel Orientation="Horizontal">
      <Button x:Name="NavMusic" Content="&#xE8D6;" Tag="0" Foreground="#F083A0" Style="{StaticResource PanelIcon}" Click="PageClicked" ToolTip="Musik" AutomationProperties.Name="Musik" />
      <Button x:Name="NavFocus" Content="&#xE916;" Tag="1" Style="{StaticResource PanelIcon}" Click="PageClicked" ToolTip="Fokus" AutomationProperties.Name="Fokus" />
      <Button x:Name="NavSpace" Content="&#xE8B7;" Tag="2" Style="{StaticResource PanelIcon}" Click="PageClicked" ToolTip="Ruang · catatan, tugas, file" AutomationProperties.Name="Ruang" />
      <Border Width="1" Height="14" Background="#36363D" Margin="3,0" />
      <Button x:Name="NavSettings" Content="&#xE713;" Tag="3" Style="{StaticResource PanelIcon}" Click="PageClicked" ToolTip="Setelan" AutomationProperties.Name="Setelan" />
     </StackPanel>
    </Border>
    <TextBlock x:Name="Status" Visibility="Collapsed" TextWrapping="Wrap" FontSize="10" Foreground="#E1BF95" MaxHeight="32" Margin="20,6,20,0" />
   </StackPanel>
  </Grid>
 </Border>
 </Viewbox>
</Window>
