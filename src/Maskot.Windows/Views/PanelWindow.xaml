<Window x:Class="Maskot.Windows.Views.PanelWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Maskot.Windows.Views"
 Title="Maskot — Momo" Width="440" Height="368" WindowStyle="None" AllowsTransparency="True"
 Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
 PreviewKeyDown="PanelKeyDown" Deactivated="PanelDeactivated" AllowDrop="True" Drop="FilesDropped" DragOver="FilesDragged">
 <Border Background="#FE050506" BorderBrush="#35353A" BorderThickness="1" CornerRadius="28" Padding="22,16,22,14">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <Grid Margin="0,0,0,12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Fill="#40DF87" Width="6" Height="6" Margin="0,0,7,0" /><TextBlock Text="M O M O" FontSize="10" FontWeight="SemiBold" Foreground="#9C9CA3" VerticalAlignment="Center" /></StackPanel>
    <TextBlock x:Name="PanelClock" Grid.Column="1" Text="00:00" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"><local:ActivityBars x:Name="PanelBars" Width="25" Margin="0,0,12,0" /><Button Content="×" Padding="6,0" Width="22" Height="22" Margin="0" Background="#242428" ToolTip="Tutup panel (Escape)" Click="CloseClicked" /></StackPanel>
   </Grid>
   <TabControl x:Name="Tabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0" TabStripPlacement="Bottom" SelectionChanged="TabChanged">
    <TabItem Header="♫  Musik">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,2,0,2">
       <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="#202737" CornerRadius="13" Width="76" Height="76" HorizontalAlignment="Left"><Grid>
         <TextBlock Text="♫" FontSize="32" Foreground="#C2CADF" HorizontalAlignment="Center" VerticalAlignment="Center" />
         <Image x:Name="Cover" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,76,76" RadiusX="13" RadiusY="13" /></Image.Clip></Image>
        </Grid></Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
         <TextBlock Text="SEDANG DIPUTAR" FontSize="9" Foreground="#77777F" Margin="0,0,0,6" />
         <TextBlock x:Name="TrackTitle" Text="Belum ada musik" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxHeight="43" TextWrapping="Wrap" />
         <TextBlock x:Name="TrackArtist" Text="Putar lagu favoritmu." Foreground="#96969E" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,5,0,0" />
        </StackPanel>
       </Grid>
       <Slider x:Name="Seek" Minimum="0" Maximum="1" Value="0" IsEnabled="False" Margin="0,12,0,0" PreviewMouseLeftButtonDown="SeekStarted" PreviewMouseLeftButtonUp="SeekFinished" PreviewKeyUp="SeekKeyUp" IsMoveToPointEnabled="True" ToolTip="Posisi lagu" />
       <Grid><TextBlock x:Name="Elapsed" Text="0:00" FontSize="10" Foreground="#818189" /><TextBlock x:Name="Duration" Text="0:00" FontSize="10" Foreground="#818189" HorizontalAlignment="Right" /></Grid>
       <Grid Margin="0,7,0,0">
        <Button Content="☷  Lirik" Click="ToggleLyricsPanel" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="11" Padding="0,6" Background="Transparent" Foreground="#A6A6B0" Margin="0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
         <Button x:Name="Previous" Width="36" Height="36" Padding="10" Background="Transparent" Click="PreviousClicked" ToolTip="Lagu sebelumnya" IsEnabled="False"><Path Data="M0,0 L2,0 L2,14 L0,14 Z M15,0 L4,7 L15,14 Z" Fill="White" Stretch="Uniform" /></Button>
         <Button x:Name="PlayPause" Width="42" Height="42" Padding="14,12" Style="{StaticResource MediaPlay}" Click="PlayClicked" ToolTip="Putar / jeda" IsEnabled="False"><Path x:Name="PlayGlyph" Data="M1,0 L12,7 L1,14 Z" Fill="#080809" Stretch="Uniform" /></Button>
         <Button x:Name="Next" Width="36" Height="36" Padding="10" Background="Transparent" Margin="0" Click="NextClicked" ToolTip="Lagu berikutnya" IsEnabled="False"><Path Data="M0,0 L11,7 L0,14 Z M13,0 L15,0 L15,14 L13,14 Z" Fill="White" Stretch="Uniform" /></Button>
        </StackPanel>
        <Button Content="Sumber" Click="ToggleSources" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Padding="0,6" Background="Transparent" Foreground="#A6A6B0" Margin="0" ToolTip="Pilih aplikasi pemutar musik" />
       </Grid>
       <TextBlock x:Name="MediaStatus" Style="{StaticResource Caption}" Margin="0,9,0,0" MaxHeight="30" />
       <Grid x:Name="SourcePicker" Visibility="Collapsed" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
        <ComboBox x:Name="Sources" SelectionChanged="SourceChanged" MinHeight="28" ToolTip="Pilih aplikasi pemutar" />
        <Button Grid.Column="1" Content="↻" Padding="5,3" Margin="6,0,0,0" ToolTip="Muat ulang sesi media" Click="RefreshMediaClicked" />
       </Grid>
       <Border x:Name="LyricsPane" Visibility="Collapsed" CornerRadius="16" Padding="14" Margin="0,12,0,0">
        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#142338" Offset="0" /><GradientStop Color="#0C0F16" Offset="1" /></LinearGradientBrush></Border.Background>
        <StackPanel><TextBlock Text="LIRIK" FontSize="9" Foreground="#869CB9" Margin="0,0,0,8" />
         <TextBlock x:Name="LyricText" Text="Aktifkan lirik online di Setelan untuk menemani musikmu." FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#E1EBFF" LineHeight="24" MaxHeight="78" />
         <TextBlock x:Name="LyricStatus" Style="{StaticResource Caption}" Margin="0,7,0,0" FontSize="10" />
         <StackPanel x:Name="LyricsConsent" Margin="0,8,0,0"><TextBlock Text="Judul, artis, dan durasi lagu dikirim ke LRCLIB untuk mencari lirik." Style="{StaticResource Caption}" FontSize="10" /><Button Content="Aktifkan lirik online" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="9,5" FontSize="11" Click="EnableLyricsClicked" /></StackPanel>
         <Button x:Name="RetryLyrics" Content="Cari lagi" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="9,4" FontSize="10" Click="RetryLyricsClicked" Visibility="Collapsed" />
        </StackPanel>
       </Border>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="Fokus">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,8,0,0">
       <TextBlock Text="Satu hal, satu waktu." Style="{StaticResource Section}" />
       <Border Background="#111114" CornerRadius="18" Padding="18,22">
        <StackPanel HorizontalAlignment="Center">
         <TextBlock x:Name="PhaseLabel" Text="WAKTU FOKUS" Foreground="{StaticResource Accent}" FontSize="11" HorizontalAlignment="Center" />
         <TextBlock x:Name="Countdown" Text="25:00" FontSize="64" FontWeight="Light" FontFamily="Segoe UI Variable Display, Segoe UI" HorizontalAlignment="Center" Margin="0,8" />
         <TextBlock x:Name="TimerStatus" Text="Tarik napas. Mulai saat kamu siap." Style="{StaticResource Caption}" HorizontalAlignment="Center" />
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
          <Button x:Name="StartPause" Content="Mulai fokus" MinWidth="115" Style="{StaticResource Primary}" Click="TimerToggle" /><Button Content="Reset" Click="TimerReset" Margin="0" />
         </StackPanel>
        </StackPanel>
       </Border>
       <Grid Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,8,0"><TextBlock Text="Fokus · menit" Style="{StaticResource Caption}" Margin="0,0,0,8" /><TextBox x:Name="FocusMinutes" Text="25" LostFocus="TimerSettingsChanged" MaxLength="3" /></StackPanel>
        <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Istirahat · menit" Style="{StaticResource Caption}" Margin="0,0,0,8" /><TextBox x:Name="BreakMinutes" Text="5" LostFocus="TimerSettingsChanged" MaxLength="3" /></StackPanel>
       </Grid>
       <TextBlock Text="Timer mengikuti waktu nyata, termasuk saat komputer tidur. Setelah sesi selesai, sesi berikutnya menunggu kamu menekan Mulai." Style="{StaticResource Caption}" Margin="0,15,0,0" />
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="Ruang">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
       <TextBlock Text="Yang ingin kamu ingat." Style="{StaticResource Section}" />
       <TextBox x:Name="Notes" AcceptsReturn="True" TextWrapping="Wrap" Height="98" VerticalScrollBarVisibility="Auto" TextChanged="ContentEdited" ToolTip="Catatan disimpan otomatis di perangkat ini" />
       <TextBlock Text="TUGAS KECIL" Style="{StaticResource Caption}" Margin="0,20,0,10" />
       <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="+" Width="36" Style="{StaticResource Primary}" Click="AddTask" Margin="8,0,0,0" /><TextBox x:Name="NewTask" KeyDown="TaskKeyDown" ToolTip="Tulis tugas, lalu tekan Enter" MaxLength="500" /></DockPanel>
       <ItemsControl x:Name="TaskList"><ItemsControl.ItemTemplate><DataTemplate>
        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions>
         <CheckBox IsChecked="{Binding Done, Mode=TwoWay}" Click="TaskEdited" />
         <TextBox Grid.Column="1" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Padding="6" MaxLength="500" LostFocus="TaskEdited" />
         <Button Grid.Column="2" Content="×" Padding="6,2" Margin="4,0,0,0" Tag="{Binding}" Click="DeleteTask" ToolTip="Hapus tugas" />
        </Grid>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <TextBlock Text="FILE SHELF" Style="{StaticResource Caption}" Margin="0,20,0,10" />
       <Border BorderBrush="#34343A" BorderThickness="1" Background="#111114" CornerRadius="12" Padding="14"><StackPanel><TextBlock Text="＋  Letakkan file di sini" Foreground="{StaticResource Accent}" /><TextBlock Text="Hanya menyimpan pintasan. File aslinya tetap di tempat." Style="{StaticResource Caption}" Margin="0,5,0,0" /></StackPanel></Border>
       <ItemsControl x:Name="ShelfList" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate>
        <StackPanel Margin="0,4" Background="#151518">
         <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="9,8,9,3" Tag="{Binding}" PreviewMouseLeftButtonDown="ShelfDragStart" PreviewMouseMove="ShelfDragMove" ToolTip="Tarik nama file ke aplikasi lain" />
         <TextBlock Text="File tidak ditemukan" Foreground="#F0BDA2" FontSize="11" Margin="9,0,0,4"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Exists}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
         <StackPanel Orientation="Horizontal" Margin="8,2,8,8"><Button Content="Buka" Padding="9,4" Tag="{Binding}" Click="OpenShelf" /><Button Content="Lokasi" Padding="9,4" Tag="{Binding}" Click="LocateShelf" /><Button Content="Hapus pintasan" Padding="9,4" Tag="{Binding}" Click="DeleteShelf" /></StackPanel>
        </StackPanel>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="Setelan">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
       <TextBlock Text="Kenalan dengan Momo." Style="{StaticResource Section}" />
       <TextBlock Text="Teman kecil yang menemanimu tanpa terburu-buru." Style="{StaticResource Caption}" Margin="0,0,0,15" />
       <StackPanel Orientation="Horizontal"><Button Content="Jalan-jalan" Style="{StaticResource Primary}" Click="WalkClicked" /><Button Content="Diam di sini" Click="StayClicked" /></StackPanel>
       <TextBlock Text="Ukuran karakter" Margin="0,20,0,7" /><Slider x:Name="SizeSlider" Minimum="0.65" Maximum="1.8" Value="1" ValueChanged="PreferenceChanged" ToolTip="Ukuran karakter" />
       <TextBlock Text="Kecepatan berjalan" Margin="0,15,0,7" /><Slider x:Name="SpeedSlider" Minimum="10" Maximum="100" Value="32" ValueChanged="PreferenceChanged" ToolTip="Kecepatan berjalan" />
       <CheckBox x:Name="Animations" Content="Animasi Momo: kaki, ekor, napas, kedip" Click="PreferenceChanged" Margin="0,15,0,5" />
       <CheckBox x:Name="Fullscreen" Content="Sembunyikan saat aplikasi fullscreen" Click="PreferenceChanged" /><TextBlock Text="Biarkan mati agar Momo tetap tampil di atas jendela fullscreen." Style="{StaticResource Caption}" Margin="0,0,0,8" />
       <CheckBox x:Name="Autostart" Content="Jalankan saat login Windows" Click="AutostartChanged" />
       <CheckBox x:Name="OnlineLyrics" Content="Lirik online melalui LRCLIB" Click="LyricsChanged" Margin="0,16,0,5" />
       <TextBlock Text="Jika diaktifkan, judul lagu, artis, dan durasi dikirim ke lrclib.net lewat HTTPS. Tanpa akun atau API key. Tidak ada telemetry." Style="{StaticResource Caption}" />
       <Border Background="#151518" CornerRadius="12" Padding="13" Margin="0,20,0,15"><TextBlock Text="Seret Momo ke tengah atas monitor, lalu lepaskan untuk menjadi notch. Tarik notch ke bawah untuk mengembalikannya. Escape membatalkan drag." Style="{StaticResource Caption}" /></Border>
       <Button Content="Keluar sepenuhnya" HorizontalAlignment="Left" Click="QuitClicked" />
       <TextBlock Text="Maskot 0.3 · Momo adalah aset vektor orisinal sementara." Style="{StaticResource Caption}" Margin="0,14,0,0" />
      </StackPanel>
     </ScrollViewer>
    </TabItem>
   </TabControl>
   <StackPanel Grid.Row="2" Margin="0,9,0,0">
    <TextBlock x:Name="Status" TextWrapping="Wrap" FontSize="10" Foreground="#E1BF95" MaxHeight="32" />
    <Grid Margin="0,3,0,0"><TextBlock x:Name="ModeStatus" Text="● Berjalan · selalu di atas" FontSize="10" Foreground="#888891" VerticalAlignment="Center" /><Button x:Name="ModeAction" Content="Diam" HorizontalAlignment="Right" Padding="10,4" FontSize="10" Margin="0" Click="ModeActionClicked" /></Grid>
   </StackPanel>
  </Grid>
 </Border>
</Window>
