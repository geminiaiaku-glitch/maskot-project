<Window x:Class="Maskot.Windows.Views.NotificationWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Momo — notifikasi" Width="380" Height="182" WindowStyle="None" AllowsTransparency="True"
 Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True">
 <Viewbox Stretch="Fill"><Border Width="380" Height="182" Background="#FB10141C" BorderBrush="#465366" BorderThickness="1" CornerRadius="20" Padding="16,12">
  <Grid><Grid.RowDefinitions><RowDefinition Height="25" /><RowDefinition Height="*" /><RowDefinition Height="28" /></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <Path Data="M3,12 L3,7 C3,0 13,0 13,7 L13,12 L15,14 L1,14 Z M6,17 Q8,20 10,17" Stroke="#A9D6C9" StrokeThickness="1.5" Width="15" Height="18" Stretch="Uniform" VerticalAlignment="Center" />
    <TextBlock x:Name="Source" Grid.Column="1" Foreground="#B6CFD0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    <TextBlock Grid.Column="2" Text="via Momo" FontSize="10" Foreground="#78889D" VerticalAlignment="Center" />
   </Grid>
   <StackPanel Grid.Row="1" Margin="0,7,0,3">
    <TextBlock x:Name="Heading" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxHeight="22" />
    <TextBlock x:Name="Message" Foreground="#BEC8D7" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" LineHeight="18" MaxHeight="54" TextTrimming="CharacterEllipsis" />
   </StackPanel>
   <Grid Grid.Row="2"><Button Content="Riwayat" HorizontalAlignment="Left" Background="Transparent" Foreground="#A9C8F1" Padding="0,4" FontSize="10" Click="OpenClicked" /><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button Content="Jeda" Padding="10,4" FontSize="10" Click="PauseClicked" /><Button Content="Tutup" Padding="10,4" FontSize="10" Margin="0" Click="DismissClicked" /></StackPanel></Grid>
  </Grid>
 </Border></Viewbox>
</Window>
